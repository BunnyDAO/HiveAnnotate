<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Hardened runtime, NOT App Sandbox. The sandbox forbids what this app is
    made of: global hotkeys over other apps and capturing their windows. See
    the PRD's distribution section and ADR 0002.

    These two are what V8 needs to run under the hardened runtime at all.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
